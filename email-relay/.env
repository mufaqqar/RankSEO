# RankSEO email relay — copy to your Next.js project's .env.local / .env

# SMTP server (your custom SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=false          # false = STARTTLS on 587/25, true = implicit TLS on 465
SMTP_USER=sales@mufaqar.com
SMTP_PASS=I$lam@7788

# "From" address shown in sent emails (optional; defaults to SMTP_USER)
MAIL_FROM=RankSEO <hello@mufaqar.com>

# Shared token the RankSEO extension sends as: Authorization: Bearer <token>
# Generate with e.g.:  openssl rand -hex 32
RANKSEO_RELAY_TOKEN=REPLACE_WITH_A_LONG_HEX_STRING